{
  "name": "realm-of-shadows",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w @realm/server\" \"npm run dev -w @realm/client\"",
    "build": "tsc --noEmit && npm run build -w @realm/client",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/multiplayer.ts && tsx tests/combat.integration.ts && tsx tests/classes.integration.ts && tsx tests/water.integration.ts && tsx tests/monsters.integration.ts && tsx tests/passive.integration.ts && tsx tests/caverns.integration.ts && tsx tests/shielding.integration.ts",
    "test:browser": "node tests/browser-movement.cjs && node tests/browser-combat.cjs && node tests/browser-classes.cjs && node tests/browser-spells.cjs && node tests/browser-profile.cjs && node tests/browser-login.cjs",
    "test:accounts": "tsx tests/accounts.integration.ts",
    "test:accounts:browser": "tsx tests/accounts.browser.ts",
    "test:startup": "tsx tests/startup.browser.ts",
    "test:equipment:browser": "node tests/browser-equipment.cjs",
    "test:character:browser": "node tests/browser-character.cjs",
    "test:paper-doll:browser": "node tests/browser-paper-doll.cjs",
    "art:elderwood": "tsx scripts/build-elderwood-svg.ts",
    "test:island:browser": "node tests/browser-island.cjs",
    "art:woods": "tsx scripts/build-woods-svg.ts",
    "art:woods-sections": "node scripts/encode-woods-sections.cjs",
    "art:map-tiles": "tsx scripts/build-map-tiles.ts && tsx scripts/build-terrain-tiles.ts",
    "art:map-previews": "node scripts/export-tiled-map-previews.cjs",
    "art:caverns": "tsx scripts/build-map-tiles.ts && node scripts/encode-caverns-sprites.cjs",
    "test:caverns:browser": "node tests/browser-caverns.cjs",
    "test:caverns:integration": "tsx tests/caverns.integration.ts",
    "art:monsters": "tsx scripts/build-monsters-svg.ts",
    "test:woods:browser": "node tests/browser-woods.cjs",
    "test:generated-art:browser": "node tests/browser-generated-art.cjs",
    "test:character-style:browser": "node tests/browser-character-style.cjs",
    "test:monsters:browser": "node tests/browser-monster-animations.cjs",
    "test:woods-exploration:browser": "node tests/browser-woods-exploration.cjs",
    "test:click-hud:browser": "node tests/browser-click-hud.cjs",
    "test:auto-approach:browser": "node tests/browser-auto-approach.cjs && node tests/browser-auto-approach-online.cjs",
    "map:editor": "npm run dev -w @realm/client -- --port 5190",
    "test:map-editor:browser": "node tests/browser-map-editor.cjs",
    "test:woods-portal:browser": "node tests/browser-woods-portal.cjs",
    "test:display:browser": "node tests/browser-display.cjs",
    "test:woods-ground:browser": "node tests/browser-woods-ground.cjs",
    "art:equipment": "python3 scripts/extract-equipment-sprites.py && python3 scripts/extract-equipment-heads.py",
    "test:equipment-tiers:browser": "node tests/browser-equipment-tiers.cjs",
    "test:attributes:browser": "node tests/browser-attributes.cjs",
    "test:identification:browser": "node tests/browser-identification.cjs",
    "test:inventory:browser": "node tests/browser-inventory.cjs",
    "test:inventory:integration": "tsx tests/inventory.integration.ts",
    "test:floors:browser": "node tests/browser-floors.cjs",
    "test:floors:integration": "tsx tests/floors.integration.ts",
    "test:woods-floors:browser": "node tests/browser-woods-floors.cjs",
    "test:woods-floors:integration": "tsx tests/woods-floors.integration.ts",
    "test:grid:browser": "node tests/browser-grid-world.cjs",
    "test:grid:integration": "tsx tests/grid-world.integration.ts",
    "art:island-terrain": "python3 scripts/extract-island-terrain.py",
    "test:depot:browser": "node tests/browser-depot.cjs",
    "test:depot:integration": "tsx tests/depot.integration.ts",
    "art:depot": "python3 scripts/extract-depot-sprites.py",
    "art:skins": "python3 scripts/extract-reference-cosmetics.py",
    "test:cosmetics:browser": "node tests/browser-cosmetics.cjs",
    "test:cosmetics:integration": "tsx tests/cosmetics.integration.ts",
    "test:cosmetics:peers": "node tests/browser-cosmetics-peers.cjs",
    "art:skins:legacy": "python3 scripts/extract-class-skins.py",
    "test:avatar-idle:browser": "node tests/browser-avatar-idle.cjs",
    "test:combat-feedback:browser": "node tests/browser-combat-feedback.cjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "playwright": "^1.64.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
