{
  "name": "realm-of-shadows",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w @realm/server\" \"npm run dev -w @realm/client\"",
    "build": "tsc --noEmit && npm run build -w @realm/client",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/multiplayer.ts && tsx tests/combat.integration.ts && tsx tests/classes.integration.ts && tsx tests/water.integration.ts && tsx tests/monsters.integration.ts && tsx tests/passive.integration.ts && tsx tests/caverns.integration.ts && tsx tests/shielding.integration.ts",
    "test:browser": "node tests/browser-movement.cjs && node tests/browser-combat.cjs && node tests/browser-classes.cjs && node tests/browser-spells.cjs && node tests/browser-profile.cjs && node tests/browser-login.cjs",
    "test:accounts": "tsx tests/accounts.integration.ts",
    "test:accounts:browser": "tsx tests/accounts.browser.ts",
    "test:startup": "tsx tests/startup.browser.ts",
    "test:equipment:browser": "node tests/browser-equipment.cjs",
    "test:character:browser": "node tests/browser-character.cjs",
    "test:paper-doll:browser": "node tests/browser-paper-doll.cjs",
    "art:elderwood": "tsx scripts/build-elderwood-svg.ts",
    "test:island:browser": "node tests/browser-island.cjs",
    "art:woods": "tsx scripts/build-woods-svg.ts",
    "art:woods-sections": "node scripts/encode-woods-sections.cjs",
    "art:map-tiles": "tsx scripts/build-map-tiles.ts && tsx scripts/build-terrain-tiles.ts",
    "art:map-previews": "node scripts/export-tiled-map-previews.cjs",
    "art:caverns": "tsx scripts/build-map-tiles.ts && node scripts/encode-caverns-sprites.cjs",
    "test:caverns:browser": "node tests/browser-caverns.cjs",
    "test:caverns:integration": "tsx tests/caverns.integration.ts",
    "art:monsters": "tsx scripts/build-monsters-svg.ts",
    "test:woods:browser": "node tests/browser-woods.cjs",
    "test:generated-art:browser": "node tests/browser-generated-art.cjs",
    "test:character-style:browser": "node tests/browser-character-style.cjs",
    "test:monsters:browser": "node tests/browser-monster-animations.cjs",
    "test:woods-exploration:browser": "node tests/browser-woods-exploration.cjs",
    "test:click-hud:browser": "node tests/browser-click-hud.cjs",
    "test:auto-approach:browser": "node tests/browser-auto-approach.cjs && node tests/browser-auto-approach-online.cjs",
    "map:editor": "npm run dev -w @realm/client -- --port 5190",
    "test:map-editor:browser": "node tests/browser-map-editor.cjs && node tests/browser-editor-tools.cjs",
    "test:woods-portal:browser": "node tests/browser-woods-portal.cjs",
    "test:display:browser": "node tests/browser-display.cjs",
    "test:woods-ground:browser": "node tests/browser-woods-ground.cjs",
    "art:equipment": "python3 scripts/extract-equipment-sprites.py && python3 scripts/extract-equipment-heads.py",
    "test:equipment-tiers:browser": "node tests/browser-equipment-tiers.cjs",
    "test:attributes:browser": "node tests/browser-attributes.cjs",
    "test:identification:browser": "node tests/browser-identification.cjs",
    "test:inventory:browser": "node tests/browser-inventory.cjs",
    "test:inventory:integration": "tsx tests/inventory.integration.ts",
    "test:floors:browser": "node tests/browser-floors.cjs",
    "test:floors:integration": "tsx tests/floors.integration.ts",
    "test:woods-floors:browser": "node tests/browser-woods-floors.cjs",
    "test:woods-floors:integration": "tsx tests/woods-floors.integration.ts",
    "test:grid:browser": "node tests/browser-grid-world.cjs",
    "test:grid:integration": "tsx tests/grid-world.integration.ts",
    "art:crafting-hall": "python3 scripts/extract-crafting-benches.py && node scripts/build-crafting-hall-sign.cjs",
    "art:town-roofs": "node scripts/build-town-roofs.cjs",
    "art:town-walls": "node scripts/build-town-walls.cjs",
    "test:town-services:browser": "node tests/browser-town-services.cjs",
    "test:town-services:integration": "tsx tests/town-services.integration.ts",
    "test:window-peeking:browser": "node tests/browser-window-peeking.cjs",
    "test:house-joins:browser": "node tests/browser-house-joins.cjs",
    "art:island-terrain": "python3 scripts/extract-island-terrain.py",
    "test:depot:browser": "node tests/browser-depot.cjs",
    "test:depot:integration": "tsx tests/depot.integration.ts",
    "art:depot": "python3 scripts/extract-depot-sprites.py",
    "art:skins": "python3 scripts/extract-reference-cosmetics.py",
    "test:cosmetics:browser": "node tests/browser-cosmetics.cjs",
    "test:cosmetics:integration": "tsx tests/cosmetics.integration.ts",
    "test:cosmetics:peers": "node tests/browser-cosmetics-peers.cjs",
    "art:skins:legacy": "python3 scripts/extract-class-skins.py",
    "test:avatar-idle:browser": "node tests/browser-avatar-idle.cjs",
    "test:combat-feedback:browser": "node tests/browser-combat-feedback.cjs",
    "test:quests:browser": "node tests/browser-quests.cjs",
    "art:professions": "python3 scripts/extract-profession-icons.py",
    "test:professions:browser": "node tests/browser-professions.cjs",
    "test:professions:integration": "tsx tests/professions.integration.ts",
    "test:resource-varieties:browser": "node tests/browser-resource-varieties.cjs",
    "art:map-furniture": "node scripts/build-map-furniture.cjs && node scripts/build-connected-counters.cjs && python3 scripts/extract-counter-tools.py && npm run art:square-props",
    "art:prop-catalog": "tsx scripts/catalog-map-props.ts && npm run art:square-props",
    "art:square-props": "python3 scripts/square-map-props.py",
    "test:elevation:integration": "tsx tests/elevation.integration.ts",
    "test:elevation:browser": "tsx tests/browser-elevation.cjs",
    "test:woods-cliffs:browser": "node tests/browser-woods-cliffs.cjs",
    "test:woods-highlands:browser": "node tests/browser-woods-highlands.cjs",
    "test:woods-highlands:integration": "tsx tests/woods-highlands.integration.ts",
    "test:map-editor:touch": "node tests/browser-editor-touch.cjs",
    "test:elderwood-plan:browser": "node tests/browser-village-portal.cjs",
    "test:elderwood-plan:integration": "tsx tests/elderwood-plan.integration.ts",
    "test:cliff-assembly:browser": "node tests/browser-cliff-assembly.cjs",
    "test:cliff-contours:browser": "node tests/browser-cliff-contours.cjs",
    "test:joined-cliffs:browser": "node tests/browser-joined-cliffs.cjs",
    "test:stair-landings:browser": "node tests/browser-stair-landing-visuals.cjs",
    "test:cliff-study:browser": "node tests/browser-cliff-study.cjs",
    "test:single-cell-stairs:browser": "node tests/browser-single-cell-stairs.cjs",
    "test:village-cliffs:browser": "node tests/browser-village-cliffs.cjs",
    "test:map-perspective:browser": "node tests/browser-map-perspective.cjs",
    "test:housing:integration": "tsx tests/housing.integration.ts",
    "test:housing:browser": "node tests/browser-housing.cjs",
    "test:housing:accounts:browser": "tsx tests/housing.browser.ts",
    "art:fences": "node scripts/build-connected-fences.cjs",
    "test:fences:browser": "node tests/browser-connected-fences.cjs",
    "test:neighborhood-life:browser": "node tests/browser-neighborhood-life.cjs",
    "test:neighborhood:integration": "tsx tests/neighborhood.integration.ts",
    "test:story:browser": "node tests/browser-story.cjs",
    "test:story:integration": "tsx tests/story.integration.ts",
    "art:story-items": "python3 scripts/extract-story-items.py",
    "test:tasks:browser": "node tests/browser-tasks.cjs",
    "test:bot:browser": "node tests/browser-bot.cjs",
    "test:bot:online": "node tests/browser-bot-online.cjs",
    "test:character-slots:browser": "tsx tests/character-slots.browser.ts",
    "test:shop:browser": "node tests/browser-cosmetic-shop.cjs",
    "test:shop:integration": "tsx tests/cosmetic-shop.integration.ts",
    "test:hud:browser": "node tests/browser-hud-skin.cjs",
    "test:automatic-loot:browser": "node tests/browser-automatic-loot.cjs",
    "test:dock-progress:browser": "node tests/browser-dock-progress.cjs",
    "test:inventory-wayfarer:browser": "node tests/browser-inventory-wayfarer.cjs",
    "art:wayfarer": "python3 scripts/encode-wayfarer-art.py",
    "test:tracker-icon:browser": "node tests/browser-tracker-icon.cjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "playwright": "^1.64.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
